# INKR — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Stripe (optional — for Premium subscriptions) ───────────────────────────
# Found in: Stripe Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY

# ─── EAS / Expo ──────────────────────────────────────────────────────────────
# Found in: expo.dev > Project > Settings
# (Only needed for EAS Build / Submit — not for local dev)
# EXPO_TOKEN=your_expo_access_token_here
#
# .env is not uploaded to EAS: cloud builds read EXPO_PUBLIC_* variables from the
# EAS environment named in eas.json (development / preview / production), see README.
#
# Optional: Expo project id for push tokens. Without it, the id written to app.json
# by `eas init` (extra.eas.projectId) is used.
# EXPO_PUBLIC_PROJECT_ID=

# Public site URL (canonical URLs, sitemap, robots.txt), e.g. https://your-site.vercel.app
# EXPO_PUBLIC_SITE_URL=

# OAuth buttons to show, matching providers enabled in Supabase (e.g. google,apple). Empty = email only.
EXPO_PUBLIC_AUTH_PROVIDERS=

# ─── Captcha (optional, web only) ────────────────────────────────────────────
# Cloudflare Turnstile SITE key (public). Empty = no captcha, sign-in works as before.
# The SECRET key never goes here: paste it in Supabase > Authentication > Attack Protection.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Edge function secrets (NOT in .env — set with `supabase secrets set`) ───
# ALLOWED_ORIGINS            Comma-separated web origins allowed to call the functions and to
#                            receive Stripe redirects, e.g. https://your-site.vercel.app
# STRIPE_SECRET_KEY          Server-side Stripe key (checkout, subscription cancel on account deletion)
# STRIPE_PRICE_MONTHLY / STRIPE_PRICE_YEARLY / STRIPE_WEBHOOK_SECRET
